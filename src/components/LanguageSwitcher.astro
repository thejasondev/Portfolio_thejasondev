---
import { locales, hrefForLocale, getDictionary } from "../i18n";
import type { Dictionary, Locale } from "../i18n/types";

interface Props {
  locale: Locale;
  dict: Dictionary;
}

const { locale, dict } = Astro.props;
---

<div class="lang-switcher relative" data-lang-switcher data-open="false">
  <button
    type="button"
    class="lang-btn"
    data-lang-btn
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls="lang-menu"
    aria-label={dict.nav.languageLabel}
    title={dict.nav.languageLabel}
  >
    <svg class="lang-globe" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle>
      <path d="M2 12h20"></path>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
    </svg>
    <span class="lang-code hidden sm:inline">{dict.shortLabel}</span>
    <svg class="lang-chevron hidden sm:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </button>

  <div class="lang-menu" id="lang-menu" role="menu" data-lang-menu hidden>
    {locales.map((l) => {
      const d = getDictionary(l);
      const active = l === locale;
      return (
        <a
          href={hrefForLocale(l)}
          class:list={["lang-item", { "is-active": active }]}
          role="menuitem"
          hreflang={d.hreflang}
          lang={d.htmlLang}
          aria-current={active ? "true" : undefined}
        >
          <span class="lang-item-code">{d.shortLabel}</span>
          <span class="lang-item-label">{d.label}</span>
          {active && (
            <svg class="lang-item-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 6 9 17l-5-5"></path>
            </svg>
          )}
        </a>
      );
    })}
  </div>
</div>

<style>
  .lang-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    height: 2.25rem;
    width: 2.25rem;
    padding: 0;
    border-radius: 9999px;
    border: 1px solid rgba(0, 0, 0, 0.1);
    background: rgba(255, 255, 255, 0.55);
    color: #171717;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    flex-shrink: 0;
    transition: border-color 0.3s ease, background 0.3s ease, transform 0.2s ease;
  }

  @media (min-width: 400px) {
    .lang-btn {
      height: 2.5rem;
      width: auto;
      padding: 0 0.625rem;
    }
  }

  .lang-btn:hover {
    border-color: rgba(212, 175, 55, 0.55);
    background: rgba(244, 228, 188, 0.35);
  }

  .lang-btn:active {
    transform: scale(0.96);
  }

  .lang-globe {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .lang-chevron {
    width: 0.75rem;
    height: 0.75rem;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  [data-open="true"] .lang-chevron {
    transform: rotate(180deg);
  }

  .lang-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    min-width: 9.5rem;
    padding: 0.375rem;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.16);
    z-index: 60;
  }

  .lang-menu[hidden] {
    display: none;
  }

  .lang-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.625rem;
    border-radius: 0.6rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #404040;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .lang-item:hover {
    background: rgba(212, 175, 55, 0.15);
    color: #000;
  }

  .lang-item.is-active {
    background: rgba(212, 175, 55, 0.18);
    color: #000;
  }

  .lang-item-code {
    min-width: 1.4rem;
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #a1a1aa;
  }

  .lang-item-label {
    flex: 1;
    white-space: nowrap;
  }

  .lang-item-check {
    width: 0.875rem;
    height: 0.875rem;
    color: #b8941f;
    flex-shrink: 0;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-lang-switcher]").forEach((root) => {
    const btn = root.querySelector<HTMLButtonElement>("[data-lang-btn]");
    const menu = root.querySelector<HTMLElement>("[data-lang-menu]");
    if (!btn || !menu) return;

    const close = () => {
      menu.hidden = true;
      root.dataset.open = "false";
      btn.setAttribute("aria-expanded", "false");
    };

    const open = () => {
      menu.hidden = false;
      root.dataset.open = "true";
      btn.setAttribute("aria-expanded", "true");
    };

    btn.addEventListener("click", (event) => {
      event.stopPropagation();
      if (menu.hidden) {
        open();
      } else {
        close();
      }
    });

    document.addEventListener("click", (event) => {
      if (!root.contains(event.target as Node)) close();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") close();
    });
  });
</script>
