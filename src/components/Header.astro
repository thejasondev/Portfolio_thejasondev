---
import { Icon } from "astro-icon/components";
import { getWhatsappLink } from "../data/social-links";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import type { Dictionary, Locale } from "../i18n/types";
import "../styles/header.css";

interface Props {
  locale: Locale;
  dict: Dictionary;
}

const { locale, dict } = Astro.props;

const desktopMenuItems = [
  { text: dict.nav.projects, href: "#projects" },
  { text: dict.nav.services, href: "#services" },
];

const whatsappLink = getWhatsappLink(dict.whatsapp.default);
---

<header class="site-header fixed w-full z-50 top-0 border-b border-transparent transition-[background-color,border-color,box-shadow] duration-300" id="main-header">
  <nav class="container-custom flex justify-between items-center gap-2 h-20 md:h-24">
    <!-- Logo with Accent -->
    <a href="#"
       id="site-logo"
       class="group flex items-center gap-2 flex-shrink-0"
       aria-label={dict.header.logoAria}>
       <span class="text-base xs:text-lg sm:text-2xl font-bold font-heading text-ink tracking-tight group-hover:text-accent transition-colors duration-300 whitespace-nowrap">
         {'{ thejasondev }'}
       </span>
    </a>

    <!-- Right group: desktop nav + language switcher + CTA -->
    <div class="flex items-center gap-2 xs:gap-3 md:gap-6">
      <!-- Desktop Nav Links (solo visible en md+) -->
      <ul class="hidden md:flex items-center gap-8">
        {desktopMenuItems.map(item => (
          <li>
            <a
              href={item.href}
              class="text-xs font-bold text-slate-700 hover:text-ink transition-colors uppercase tracking-widest relative group"
            >
              {item.text}
              <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-accent transition-all duration-300 group-hover:w-full"></span>
            </a>
          </li>
        ))}
      </ul>

      <!-- Language Switcher -->
      <LanguageSwitcher locale={locale} dict={dict} />

      <!-- CTA Unificado — Responsive en todos los breakpoints -->
      <a
        href={whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        id="header-cta"
        class="header-cta group"
        aria-label={dict.header.ctaAria}
      >
        <Icon name="mdi:whatsapp" class="header-cta-icon" />
        <span class="hidden md:inline">{dict.header.cta}</span>
      </a>
    </div>
  </nav>
</header>

<script>
  import '../scripts/header-scroll.ts';
</script>
