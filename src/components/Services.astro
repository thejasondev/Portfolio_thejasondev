---
import { Icon } from "astro-icon/components";
import { services, getWhatsappLink } from "../data/services";
import { getDictionary, localized } from "../i18n";
import type { Locale } from "../i18n/types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
---

<section id="services" class="section-padding bg-gradient-to-b from-slate-50 to-white relative overflow-hidden">
  <div class="container-custom relative">
    <div class="text-center max-w-3xl mx-auto mb-16 md:mb-20">
      <h2 class="text-3xl md:text-5xl font-bold font-heading mb-6 text-ink text-balance">
        {dict.services.title} <span class="text-accent">{dict.services.titleHighlight}</span>
      </h2>
      <p class="text-lg text-slate-600 leading-relaxed text-pretty">
        {dict.services.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-2 xl:grid-cols-4 gap-6 items-stretch">
      {services.map((service) => {
        const price = localized(service.price, locale);
        const isConsult = price === dict.services.priceConsult;
        const featured = service.featured === true;
        return (
        <div
          class:list={[
            "relative rounded-2xl p-7 flex flex-col border transition-shadow duration-300",
            featured
              ? "bg-ink text-white border-ink shadow-[0_24px_48px_-20px_rgba(11,27,51,0.55)]"
              : "bg-white border-slate-200 shadow-[0_1px_2px_rgba(11,27,51,0.04),0_12px_28px_-16px_rgba(11,27,51,0.18)] hover:shadow-[0_1px_2px_rgba(11,27,51,0.04),0_20px_40px_-16px_rgba(11,27,51,0.24)]",
          ]}
        >
          {featured && (
            <span class="absolute -top-3 left-7 px-3 py-1 rounded-full bg-accent text-white text-xs font-semibold">
              {dict.services.featured}
            </span>
          )}

          <div class="mb-6">
            <div class="flex items-center gap-3 mb-3">
              <Icon name={service.icon} class:list={["w-6 h-6 flex-shrink-0", featured ? "text-accent-soft" : "text-accent"]} aria-hidden="true" />
              <h3 class:list={["text-2xl font-bold font-heading", featured ? "text-white" : "text-ink"]}>
                {localized(service.title, locale)}
              </h3>
            </div>
            <p class:list={["leading-relaxed text-pretty", featured ? "text-slate-300" : "text-slate-600"]}>
              {localized(service.description, locale)}
            </p>
          </div>

          <ul class="space-y-3 mb-8 flex-grow">
            {service.features.map(feature => (
              <li class:list={["flex items-start gap-3", featured ? "text-slate-200" : "text-slate-700"]}>
                <Icon name="mdi:check" class:list={["w-5 h-5 flex-shrink-0", featured ? "text-accent-soft" : "text-accent"]} aria-hidden="true" />
                <span class="text-sm">{localized(feature, locale)}</span>
              </li>
            ))}
          </ul>

          <div class:list={["pt-6 border-t", featured ? "border-white/10" : "border-slate-100"]}>
            <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 mb-6">
              <span class:list={["font-bold font-heading", isConsult ? "text-2xl" : "text-4xl", featured ? "text-white" : "text-ink"]}>{price}</span>
              {!isConsult && <span class:list={["text-sm", featured ? "text-slate-300" : "text-slate-600"]}>{dict.services.perPayment}</span>}
            </div>

            <a
              href={getWhatsappLink(localized(service.message, locale))}
              target="_blank"
              rel="noopener noreferrer"
              class:list={["w-full flex items-center justify-center gap-2 group/btn", featured ? "btn-accent" : "btn-secondary"]}
            >
              {dict.services.hire}
              <Icon name="mdi:arrow-right" class="w-4 h-4 transform group-hover/btn:translate-x-1 transition-transform" />
            </a>
          </div>
        </div>
        );
      })}
    </div>
  </div>
</section>
