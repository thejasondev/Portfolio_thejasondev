---
import { Icon } from "astro-icon/components";
import { getWhatsappLink, socialLinks } from "../data/social-links";
import type { Dictionary, Locale } from "../i18n/types";

interface Props {
  locale: Locale;
  dict: Dictionary;
}

const { locale, dict } = Astro.props;
const whatsappLink = getWhatsappLink(dict.whatsapp.default);
// En el hero solo mostramos las redes profesionales principales
const heroSocials = socialLinks.filter((s) => s.name !== "Twitter");
---

<section id="about" class="relative pt-32 pb-20 lg:pt-44 lg:pb-32 overflow-hidden bg-gradient-to-b from-slate-50 to-white">
  <div class="container-custom relative">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">

      {/* Text Content */}
      <div class="order-2 lg:order-1 space-y-8 text-center lg:text-left hero-enter">

        {/* Main Headline with Brand Keywords for SEO */}
        <h1 class="text-[2.6rem] xs:text-5xl lg:text-7xl xl:text-8xl font-bold font-heading leading-[1.05] text-ink text-balance">
          <span class="sr-only">thejasondev - Jason Guerra | </span>
          {dict.hero.role} <br class="hidden lg:block" />
          <span class="text-accent">{dict.hero.roleHighlight}</span>
        </h1>

        {/* Tagline with Portfolio keyword */}
        <p
          class="hero-tagline text-lg lg:text-xl text-slate-700 max-w-2xl mx-auto lg:mx-0 leading-relaxed"
          set:html={dict.hero.tagline}
        />

        {/* CTA Button - Single focused action */}
        <div class="flex flex-col items-center lg:items-start gap-4 pt-2">
          <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="btn-primary flex items-center justify-center gap-2 group" aria-label={dict.hero.contactAria}>
            <Icon name="mdi:whatsapp" class="w-5 h-5" />
            {dict.hero.contact}
            <Icon name="mdi:arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
          </a>

          {/* Availability status */}
          <p class="flex items-center gap-2 text-sm text-slate-600">
            <span class="h-2 w-2 rounded-full bg-emerald-500 ring-4 ring-emerald-500/15" aria-hidden="true"></span>
            {dict.hero.available}
          </p>
        </div>

        {/* Social Links */}
        <div class="pt-4 flex items-center justify-center lg:justify-start gap-3">
          {heroSocials.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.label}
              class="p-3 rounded-full border border-slate-200 bg-white text-slate-700 hover:border-accent hover:text-accent transition-colors duration-300"
            >
              <Icon name={social.icon} class="w-5 h-5" />
            </a>
          ))}
        </div>
      </div>

      {/* Image/Graphic */}
      <div class="order-1 lg:order-2 flex justify-center lg:justify-end">
        <div class="relative w-64 h-64 sm:w-80 sm:h-80 lg:w-[480px] lg:h-[480px]">

          {/* Main Profile Image */}
          <div class="relative w-full h-full rounded-full overflow-hidden ring-1 ring-slate-200 shadow-[0_24px_60px_-20px_rgba(11,27,51,0.35)]">
            <img
              src="/profile-pic/thejasondev-perfil.webp"
              alt={dict.hero.imgAlt}
              class="w-full h-full object-cover"
              width="720"
              height="960"
              loading="eager"
              fetchpriority="high"
            />
          </div>

          {/* Experience Badge */}
          <div class="absolute bottom-6 -left-2 sm:-left-6 bg-white border border-slate-200 px-4 py-3 sm:px-5 sm:py-4 rounded-2xl shadow-[0_12px_32px_-12px_rgba(11,27,51,0.25)]">
            <p class="text-[11px] sm:text-xs text-slate-600 font-semibold uppercase tracking-wider mb-0.5">{dict.hero.experienceLabel}</p>
            <p class="text-xl sm:text-2xl font-heading font-bold text-ink">{dict.hero.experienceYears}</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* El tagline llega como HTML desde el diccionario; reforzamos el énfasis */
  .hero-tagline :global(strong),
  .hero-tagline :global(span[itemprop="name"]) {
    font-weight: 600;
    color: var(--color-ink);
  }
</style>
