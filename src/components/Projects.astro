---
import { projects } from "../data/projects";
import { getDictionary, localized } from "../i18n";
import type { Locale } from "../i18n/types";
import { Icon } from "astro-icon/components";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
---

<section id="projects" class="section-padding bg-white relative overflow-hidden">
  <div class="container-custom relative">
    <div class="text-center max-w-3xl mx-auto mb-12 md:mb-20">
      <h2 class="text-3xl md:text-5xl font-bold font-heading mb-4 md:mb-6 text-ink text-balance">
        {dict.projects.title} <span class="text-accent">{dict.projects.titleHighlight}</span>
      </h2>
      <p class="text-base md:text-lg text-slate-600 leading-relaxed text-pretty">
        {dict.projects.subtitle}
      </p>
    </div>

    {/* Desktop Layout */}
    <div class="hidden md:block space-y-24">
      {projects.map((project, index) => (
        <article class="group relative grid md:grid-cols-2 gap-12 lg:gap-20 items-center">

          {/* Project Image */}
          <div class={`relative ${index % 2 === 1 ? 'md:order-2' : ''}`}>
            <div class="relative rounded-2xl overflow-hidden bg-slate-50 ring-1 ring-slate-200 shadow-[0_24px_48px_-24px_rgba(11,27,51,0.3)]">
              <img
                src={project.image}
                alt={project.title}
                class="w-full h-auto transform group-hover:scale-[1.02] transition-transform duration-700 ease-out"
                width={project.imageWidth}
                height={project.imageHeight}
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>

          {/* Project Info */}
          <div class={`space-y-6 ${index % 2 === 1 ? 'md:order-1' : ''}`}>
            <div class="space-y-4">
              <h3 class="text-3xl lg:text-4xl font-bold font-heading text-ink text-balance">
                {project.title}
              </h3>
              <p class="text-lg text-slate-600 leading-relaxed max-w-[65ch] text-pretty">
                {localized(project.description, locale)}
              </p>
            </div>

            <ul class="flex flex-wrap gap-2" aria-label="Stack">
              {project.technologies.map((tech) => (
                <li class="px-3 py-1 bg-slate-100 text-slate-700 text-xs font-medium rounded-full">
                  {tech}
                </li>
              ))}
            </ul>

            <div class="pt-2">
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 btn-secondary group/link"
                aria-label={dict.projects.visitAria.replace("{title}", project.title)}
              >
                {dict.projects.visitSite}
                <Icon name="mdi:arrow-top-right" class="w-4 h-4 transform group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5 transition-transform" />
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    {/* Mobile Layout — Card compacta con captura */}
    <div class="md:hidden space-y-6">
      {projects.map((project) => (
        <article class="rounded-2xl overflow-hidden bg-white border border-slate-200 shadow-[0_12px_28px_-18px_rgba(11,27,51,0.25)]">
          <img
            src={project.image}
            alt={project.title}
            class="w-full h-auto bg-slate-50 border-b border-slate-100"
            width={project.imageWidth}
            height={project.imageHeight}
            loading="lazy"
            decoding="async"
          />

          <div class="p-5">
            {/* Header: Logo + Título inline */}
            <div class="flex items-center gap-3 mb-3">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg overflow-hidden border border-slate-200 bg-white">
                <img
                  src={project.logo}
                  alt=""
                  class="w-full h-full object-contain p-1"
                  loading="lazy"
                  decoding="async"
                  width="40"
                  height="40"
                />
              </div>
              <h3 class="text-lg font-bold font-heading text-ink leading-tight">
                {project.title}
              </h3>
            </div>

            <p class="text-sm text-slate-600 leading-relaxed mb-4 text-pretty">
              {localized(project.description, locale)}
            </p>

            <ul class="flex flex-wrap gap-1.5 mb-5" aria-label="Stack">
              {project.technologies.map((tech) => (
                <li class="px-2.5 py-1 text-xs font-medium text-slate-700 rounded-full bg-slate-100">
                  {tech}
                </li>
              ))}
            </ul>

            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent hover:text-accent-dark underline-offset-4 hover:underline"
              aria-label={dict.projects.visitAria.replace("{title}", project.title)}
            >
              {dict.projects.visitSite}
              <Icon name="mdi:arrow-top-right" class="w-4 h-4" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
