---
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from '@vercel/speed-insights/astro';
import SEO from '../components/SEO.astro';
import Prefetch from '../components/Prefetch.astro';
import type { Dictionary, Locale } from '../i18n/types';
import '@fontsource-variable/inter';
import '@fontsource/playfair-display/400.css';
import '@fontsource/playfair-display/500.css';
import '@fontsource/playfair-display/600.css';
import '@fontsource/playfair-display/700.css';
import '../styles/global.css';
import '../styles/animations.css';

interface Props {
  locale: Locale;
  dict: Dictionary;
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  type?: string;
  datePublished?: string;
  dateModified?: string;
  author?: string;
}

const {
  locale,
  dict,
  title,
  description,
  keywords,
  image,
  type,
  datePublished,
  dateModified,
  author,
} = Astro.props;
---

<!DOCTYPE html>
<html lang={dict.htmlLang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <!-- SEO y metadatos -->
    <SEO
      locale={locale}
      title={title}
      description={description}
      keywords={keywords}
      image={image}
      type={type}
      datePublished={datePublished}
      dateModified={dateModified}
      author={author}
    />
    <Prefetch />

    <!-- Analytics & Speed Insights -->
    <Analytics />
    <SpeedInsights />
  </head>
  <body class="bg-white text-gray-900 antialiased selection:bg-indigo-100 selection:text-indigo-900">
    <slot />

    <!-- Service Worker -->
    <script>
      import { ServiceWorkerManager } from '../scripts/service-worker.ts';
      ServiceWorkerManager.init();
    </script>

  </body>
</html>
